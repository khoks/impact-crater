# --- Local media work directories ---
# Anchor to repo root so the `backend/impact_crater/media/` python
# package is NOT ignored — that subtle bug ate the S-2.3.1 ffmpeg
# resolver in M2 (file existed locally + tests passed but the file
# never reached master).
/media/
/.cache-media/
/renders/
/exports/

# --- Docker ---
docker-compose.override.yml

# --- Misc ---
.cache/
tmp/
temp/
*.log

# Smoke-test rendered outputs (wiki_smoke_test.py and friends drop these
# at repo root). Binary, regenerated on every run.
*-smoke-test.mp4

# --- Personal launcher scripts (not committed) ---
start-impact-crater.bat
start-impact-crater.sh

